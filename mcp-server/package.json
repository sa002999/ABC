{
  "name": "kinu-tabi-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node build.mjs",
    "start": "node --env-file-if-exists=.env main.mjs",
    "stdio": "node --env-file-if-exists=.env main.mjs --stdio",
    "preview": "node --env-file-if-exists=.env preview.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "verify:live": "node --env-file-if-exists=.env verify-live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.1.0",
    "zod": "^4.2.0"
  },
  "devDependencies": { "esbuild": "^0.25.0" }
}
