# FastAPI origin only. Do not include /api or any credentials.
KINUTABI_API_BASE_URL=http://127.0.0.1:8000
# Website origin for "add a photo". Use the exact origin used to sign in.
# Vite development: http://localhost:5173; backend-served frontend: http://127.0.0.1:8000.
# No /try-on path, credentials, query, or fragment; remote origins require HTTPS.
KINUTABI_WEB_BASE_URL=http://localhost:5173
# Absolute image URLs visible to the user's browser. Defaults to the API origin.
# KINUTABI_ASSET_BASE_URL=https://api.example.com
# Explicit HTTPS image origins, separated by commas, for CloudFront/catalog images.
KINUTABI_IMAGE_ORIGINS=https://dkwx35rlj68fs.cloudfront.net
HOST=127.0.0.1
PORT=3001
# Exact HTTPS origin for a reverse proxy/tunnel; omit /mcp. Keep HOST on loopback.
# MCP_PUBLIC_ORIGIN=https://your-tunnel.trycloudflare.com
# Required if HOST is not loopback. This is a temporary developer gate, NOT a member token.
# MCP_DEV_TOKEN=replace-with-a-long-random-development-token
