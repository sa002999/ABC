# Copy to .env and enter local credentials. Never commit .env.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Existing postgresql+psycopg:// URLs are also accepted.
AWS_REGION=
S3_BUCKET=
CLOUDFRONT_DOMAIN=
# Local IAM user credentials; leave empty on EC2 and use an instance role instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Temporary credentials only. Leave unset for a normal IAM access key.
AWS_SESSION_TOKEN=
DATABASE_SECRET_ID=
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:8000
FIREBASE_PROJECT_ID=kinu-tabi
# Firebase private service-account JSON. Keep separate from Vertex ADC.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Optional Vertex service-account JSON on EC2. Locally, unset to use gcloud ADC.
# GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-northeast1
# Optional overrides; preserve other Google services' location.
VERTEX_TRY_ON_MODEL=virtual-try-on-001
VERTEX_TRY_ON_LOCATION=

# Exact Vercel origin in production; localhost origins for local Vite development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
