# AWS 設定
AWS_REGION=
S3_BUCKET=
CLOUDFRONT_DOMAIN=
DATABASE_SECRET_ID=

# PostgreSQL 連線，僅用於本機開發使用，正式佈署請保持空值，並使用 DATABASE_SECRET_ID 取得連線資訊。
DATABASE_URL=

# 本機以 HTTP 啟動時設定 COOKIE_SECURE=0；HTTPS 部署保留預設值 1。
COOKIE_SECURE=
PUBLIC_ORIGIN=

# Firebase 與 Vertex AI 共用 ADC 機制。
# 本機：執行 gcloud auth application-default login，並省略 GOOGLE_APPLICATION_CREDENTIALS。
# EC2：由各自的 systemd 服務設定 GOOGLE_APPLICATION_CREDENTIALS。
# API 指向 kinu-tabi-firebase-wif.json，Worker 指向 kinu-tabi-vertex-wif.json，均使用 EC2 絕對路徑。

# Firebase 專案 ID，由 API 用於登入與手機驗證。
FIREBASE_PROJECT_ID=

# Vertex AI 專案與地區。EC2 的 API 和 Worker 使用相同的值。
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Exact Vercel origin in production; localhost origins for local Vite development.
CORS_ORIGINS=

# Booking contact email verification
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
