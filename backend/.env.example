# AWS 設定
AWS_REGION=
S3_BUCKET=
CLOUDFRONT_DOMAIN=
DATABASE_SECRET_ID=

# PostgreSQL 連線，僅用於本機開發使用，正式佈署請保持空值，並使用 DATABASE_SECRET_ID 取得連線資訊。
DATABASE_URL=

# 本機以 HTTP 啟動時設定 COOKIE_SECURE=0；HTTPS 部署保留預設值 1。
COOKIE_SECURE=
PUBLIC_ORIGIN=

# Firebase Admin SDK 設定
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_PROJECT_ID=

# Google Vertex AI 設定
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Exact Vercel origin in production; localhost origins for local Vite development.
CORS_ORIGINS=
